[Unit]
Description=Salt Security Agent - Celery worker
Documentation=https://github.com/
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=salt-security-agent
Group=salt-security-agent
WorkingDirectory=/etc/salt-security-agent
ExecStart=/opt/salt-security-agent/venv/bin/salt-security-agent worker --config /etc/salt-security-agent/config.toml --loglevel INFO
Restart=on-failure
RestartSec=5

# Give Celery time to finish in-flight scans before being killed.
KillMode=mixed
TimeoutStopSec=30

# Hardening. The salt CLI (salt, salt-key) and the Salt state repo
# (config: [salt].repo_path) must be reachable for the salt-security-agent user.
# The config directory (config, API token, threat models, tasks) is read-only
# for the service: the process that talks to the LLM must not be able to
# rewrite its own instructions or settings. The only writable location is the
# state directory /var/lib/salt-security-agent; point
# [scanning].report_directory there (e.g. /var/lib/salt-security-agent/reports).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/salt-security-agent
StateDirectory=salt-security-agent
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
